{
  "version": "0.1.0",
  "stack": "electron",
  "extends": "../rules-config.json",
  "rulesFile": ".ai-rules.md",
  "i18n": {
    "defaultLocale": "zh-CN",
    "supportedLocales": [
      "zh-CN",
      "en",
      "zh-TW",
      "ja",
      "ko",
      "es",
      "fr"
    ],
    "localeDir": "../../i18n"
  },
  "enabledRuleIds": [
    "ELEC-301",
    "ELEC-302",
    "ELEC-303"
  ],
  "severityThreshold": "WARN",
  "scopes": [
    "security",
    "ui"
  ],
  "detectOptions": {
    "include": [
      "src/**/*.{js,jsx,ts,tsx}",
      "electron/**/*.{js,ts}",
      "preload/**/*.{js,ts}"
    ],
    "exclude": [
      "**/*.test.*",
      "node_modules/**",
      "dist/**",
      "build/**"
    ]
  },
  "prompt": {
    "style": "strict",
    "includeContextAssets": true,
    "promptTemplateKeys": {
      "auditSystem": "prompt.audit.system",
      "auditUser": "prompt.audit.user",
      "repairSystem": "prompt.repair.system",
      "repairUser": "prompt.repair.user"
    }
  }
}

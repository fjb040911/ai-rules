{
  "version": "0.1.0",
  "stack": "nodejs-base",
  "rulesFile": ".ai-rules.md",
  "i18n": {
    "defaultLocale": "zh-CN",
    "supportedLocales": [
      "zh-CN",
      "en",
      "zh-TW",
      "ja",
      "ko",
      "es",
      "fr"
    ],
    "localeDir": "../i18n"
  },
  "enabledRuleIds": [
    "NODE-ARCH-101",
    "NODE-ARCH-102",
    "NODE-ERR-201",
    "NODE-SEC-202",
    "NODE-PERF-301"
  ],
  "severityThreshold": "WARN",
  "scopes": [
    "transport",
    "security",
    "reliability"
  ],
  "detectOptions": {
    "include": [
      "src/**/*.{js,ts}",
      "app/**/*.{js,ts}",
      "*.js",
      "*.ts"
    ],
    "exclude": [
      "**/*.test.*",
      "**/*.spec.*",
      "node_modules/**",
      "dist/**",
      "build/**"
    ]
  },
  "prompt": {
    "style": "strict",
    "includeContextAssets": true,
    "promptTemplateKeys": {
      "auditSystem": "prompt.audit.system",
      "auditUser": "prompt.audit.user",
      "repairSystem": "prompt.repair.system",
      "repairUser": "prompt.repair.user"
    }
  }
}

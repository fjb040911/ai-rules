{
  "version": "0.1.0",
  "stack": "c-cpp",
  "rulesFile": ".ai-rules.md",
  "i18n": {
    "defaultLocale": "zh-CN",
    "supportedLocales": [
    "zh-CN",
    "en",
    "zh-TW",
    "ja",
    "ko",
    "es",
    "fr"
    ],
    "localeDir": "../i18n"
  },
  "enabledRuleIds": [
    "ARCH-101",
    "ARCH-102",
    "MEM-201",
    "MEM-202",
    "MEM-203",
    "MEM-204",
    "DRV-DMA-201",
    "CONC-301",
    "CONC-302",
    "CONC-303",
    "CONC-304",
    "API-401",
    "API-402",
    "API-403",
    "BUILD-501",
    "BUILD-502",
    "SEC-601",
    "SEC-602",
    "LOGIC-801",
    "ERR-303",
    "SEC-603",
    "SEC-604",
    "SEC-605",
    "DRV-PROTO-501",
    "TEST-701"
  ],
  "severityThreshold": "WARN",
  "scopes": [
    "architecture",
    "memory",
    "resource",
    "dma",
    "concurrency",
    "logic",
    "error-handling",
    "api",
    "build",
    "security",
    "parsing",
    "protocol",
    "test"
  ],
  "detectOptions": {
    "include": [
      "src/**/*.{c,cc,cpp,cxx,h,hh,hpp,hxx}",
      "tests/**/*.{c,cc,cpp,cxx,h,hh,hpp,hxx}",
      "CMakeLists.txt",
      "**/CMakeLists.txt",
      "Makefile"
    ],
    "exclude": [
      "build/**",
      "out/**",
      "third_party/**"
    ]
  },
  "prompt": {
    "style": "strict",
    "includeContextAssets": true,
    "promptTemplateKeys": {
      "auditSystem": "prompt.audit.system",
      "auditUser": "prompt.audit.user",
      "repairSystem": "prompt.repair.system",
      "repairUser": "prompt.repair.user"
    }
  }
}

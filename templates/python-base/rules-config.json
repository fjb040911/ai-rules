{
  "version": "0.1.0",
  "stack": "python-base",
  "rulesFile": ".ai-rules.md",
  "i18n": {
    "defaultLocale": "zh-CN",
    "supportedLocales": [
    "zh-CN",
    "en",
    "zh-TW",
    "ja",
    "ko",
    "es",
    "fr"
    ],
    "localeDir": "../i18n"
  },
  "enabledRuleIds": [
    "PYBASE-CODE-101",
    "PYBASE-CODE-102",
    "PYBASE-CODE-103",
    "PYBASE-TYPE-201",
    "PYBASE-TYPE-202",
    "PYBASE-TYPE-203",
    "PYBASE-SEC-301",
    "PYBASE-SEC-302",
    "PYBASE-SEC-303",
    "PYBASE-SEC-304",
    "PYBASE-SEC-305",
    "PYBASE-TEST-401",
    "PYBASE-REPRO-501",
    "ML-STATE-301",
    "ML-CONF-303",
    "ML-CKPT-304",
    "PYBASE-ERR-601",
    "PYBASE-IO-602",
    "PYBASE-IO-603",
    "ML-IO-101",
    "ML-PRECISION-202",
    "ML-EVAL-501"
  ],
  "thresholds": {
    "maxFunctionLines": 60,
    "maxParamsCount": 5
  },
  "severityThreshold": "WARN",
  "scopes": [
    "code-safety",
    "typing",
    "security",
    "test",
    "reproducibility",
    "model-state",
    "model-config",
    "model-checkpoint",
    "error-handling",
    "io",
    "model-io",
    "model-precision",
    "model-eval"
  ],
  "detectOptions": {
    "include": [
      "**/*.py",
      "pyproject.toml",
      "requirements*.txt"
    ],
    "exclude": [
      ".venv/**",
      "venv/**",
      "__pycache__/**",
      ".pytest_cache/**",
      "build/**",
      "dist/**"
    ]
  },
  "prompt": {
    "style": "strict",
    "includeContextAssets": true,
    "promptTemplateKeys": {
      "auditSystem": "prompt.audit.system",
      "auditUser": "prompt.audit.user",
      "repairSystem": "prompt.repair.system",
      "repairUser": "prompt.repair.user"
    }
  }
}
